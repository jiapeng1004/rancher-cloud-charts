# 复制为 .env 后按需覆盖（各服务 compose 均支持 ${VAR:-默认值}）

# --- MySQL ---
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=app
MYSQL_PORT=3306
# MYSQL_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/mysql:8.0

# --- Redis ---
REDIS_PASSWORD=
REDIS_PORT=6379

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_DB=app
POSTGRES_PORT=5432

# --- MongoDB ---
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=123456
MONGO_PORT=27017

# --- Elasticsearch ---
ES_PORT=9200
ES_JAVA_OPTS=-Xms512m -Xmx512m

# --- Kafka（Apache kafka-native，KRaft 单节点）---
KAFKA_PORT=9092
# 宿主机 Java 联调时 metadata 异常可设：KAFKA_ADVERTISED_HOST=127.0.0.1
# KAFKA_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/apache/kafka-native:3.9.0

# --- RabbitMQ ---
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=123456
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
